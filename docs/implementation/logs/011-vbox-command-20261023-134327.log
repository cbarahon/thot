```rust
use std::process::{Command, Stdio};
use std::time::{Duration, Instant};
use std::io::{Read, Write};
use std::os::unix::process::CommandExt;

pub struct VBoxManageCommand {
    executable: String,
    args: Vec<String>,
    timeout: Duration,
    max_output_size: usize,
    user_home: String,
    service_account: String,
}

impl VBoxManageCommand {
    pub fn new(
        executable: String,
        args: Vec<String>,
        timeout: Duration,
        max_output_size: usize,
        user_home: String,
        service_account: String,
    ) -> Self {
        VBoxManageCommand {
            executable,
            args,
            timeout,
            max_output_size,
            user_home,
            service_account,
        }
    }

    pub fn run(&self) -> Result<(i32, String, Duration, Option<String>), String> {
        let mut command = Command::new(&self.executable);
        command.args(&self.args);
        command.env("VBOX_USER_HOME", &self.user_home);
        command.current_dir(&self.user_home);
        command.stdin(Stdio::null());
        command.stdout(Stdio::piped());
        command.stderr(Stdio::piped());
        command.uid(self.service_account.parse().map_err(|_| "Invalid service account UID")?);
        command.gid(self.service_account.parse().map_err(|_| "Invalid service account GID")?);

        let mut child = command.spawn().map_err(|e| format!("Failed to spawn command: {}", e))?;

        let start_time = Instant::now();
        let mut stdout = String::new();
        let mut stderr = String::new();

        if let Some(mut stdout_handle) = child.stdout.take() {
            let mut buffer = [0; 1024];
            while let Ok(n) = stdout_handle.read(&mut buffer) {
                if n == 0 {
                    break;
                }
                stdout.push_str(std::str::from_utf8(&buffer[..n]).map_err(|_| "Invalid UTF-8")?);
                if stdout.len() > self.max_output_size {
                    stdout.truncate(self.max_output_size);
                    break;
                }
            }
        }

        if let Some(mut stderr_handle) = child.stderr.take() {
            let mut buffer = [0; 1024];
            while let Ok(n) = stderr_handle.read(&mut buffer) {
                if n == 0 {
                    break;
                }
                stderr.push_str(std::str::from_utf8(&buffer[..n]).map_err(|_| "Invalid UTF-8")?);
                if stderr.len() > self.max_output_size {
                    stderr.truncate(self.max_output_size);
                    break;
                }
            }
        }

        let status = child.wait().map_err(|e| format!("Failed to wait for command: {}", e))?;
        let duration = start_time.elapsed();

        if status.success() {
            Ok((status.code().unwrap_or(0), stdout, duration, None))
        } else {
            Ok((status.code().unwrap_or(0), stderr, duration, Some(format!("Command failed with status: {}", status))))
        }
    }
}
