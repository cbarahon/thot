use axum::{
    routing::{post, get},
    Router,
    Json,
    http::StatusCode,
};
use serde::{Deserialize, Serialize};
use std::collections::HashMap;

#[derive(Serialize, Deserialize)]
struct Run {
    id: String,
    project_id: String,
    delivery_directory: String,
    test_result_ids: Vec<String>,
    evidence_references: Vec<String>,
}

#[derive(Serialize, Deserialize)]
struct Expedient {
    id: String,
    project_id: String,
    delivery_directory: String,
}

#[derive(Serialize, Deserialize)]
struct CleanupRequest {
    project_id: String,
    delivery_directory: String,
}

#[derive(Serialize, Deserialize)]
struct CancelRequest {
    project_id: String,
    delivery_directory: String,
}

#[derive(Serialize, Deserialize)]
struct Error {
    code: u16,
    message: String,
}

async fn create_run(Json(run): Json<Run>) -> Result<Json<Run>, StatusCode> {
    // Implement logic to create a run
    // Return a stable ID and structured errors
    Ok(Json(run))
}

async fn get_run(run_id: String) -> Result<Json<Run>, StatusCode> {
    // Implement logic to retrieve a run
    // Return test_result IDs and evidence references
    Ok(Json(Run {
        id: run_id,
        project_id: "project1".to_string(),
        delivery_directory: "delivery1".to_string(),
        test_result_ids: vec!["test1".to_string(), "test2".to_string()],
        evidence_references: vec!["evidence1".to_string(), "evidence2".to_string()],
    }))
}

async fn get_expedient(expedient_id: String) -> Result<Json<Expedient>, StatusCode> {
    // Implement logic to retrieve an expedient
    Ok(Json(Expedient {
        id: expedient_id,
        project_id: "project1".to_string(),
        delivery_directory: "delivery1".to_string(),
    }))
}

async fn cleanup_expedient(Json(request): Json<CleanupRequest>) -> Result<StatusCode, StatusCode> {
    // Implement logic to cleanup an expedient
    Ok(StatusCode::OK)
}

async fn cancel_run(Json(request): Json<CancelRequest>) -> Result<StatusCode, StatusCode> {
    // Implement logic to cancel a run
    Ok(StatusCode::OK)
}

pub fn delivery_runs_router() -> Router {
    Router::new()
        .route("/api/v1/runs", post(create_run))
        .route("/api/v1/runs/:run_id", get(get_run))
        .route("/api/v1/expedients/:expedient_id", get(get_expedient))
        .route("/api/v1/expedients/:expedient_id/cleanup", post(cleanup_expedient))
        .route("/api/v1/runs/:run_id/cancel", post(cancel_run))
}
