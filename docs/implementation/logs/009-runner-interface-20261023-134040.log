```rust
use std::error::Error;
use std::path::Path;

// Define the public runner interface used by thot-engine for local VM operations
pub trait Runner {
    // OVA import
    async fn import_ova(&self, ova_path: &Path) -> Result<(), Box<dyn Error>>;

    // VM inspection
    async fn inspect_vm(&self, vm_name: &str) -> Result<VmInfo, Box<dyn Error>>;

    // Power-on VM
    async fn power_on_vm(&self, vm_name: &str) -> Result<(), Box<dyn Error>>;

    // Power-off VM
    async fn power_off_vm(&self, vm_name: &str) -> Result<(), Box<dyn Error>>;

    // Check VM state
    async fn check_vm_state(&self, vm_name: &str) -> Result<VmState, Box<dyn Error>>;

    // Capture screenshot
    async fn capture_screenshot(&self, vm_name: &str, output_path: &Path) -> Result<(), Box<dyn Error>>;

    // Cleanup VM
    async fn cleanup_vm(&self, vm_name: &str) -> Result<(), Box<dyn Error>>;

    // HTTP readiness probe
    async fn http_readiness_probe(&self, url: &str) -> Result<bool, Box<dyn Error>>;

    // SSH filesystem inspection
    async fn ssh_filesystem_inspection(&self, vm_name: &str, ssh_config: &SshConfig) -> Result<FilesystemInfo, Box<dyn Error>>;
}

// Define the VM information struct
pub struct VmInfo {
    pub name: String,
    pub state: VmState,
    pub ip_address: Option<String>,
}

// Define the VM state enum
pub enum VmState {
    Running,
    PoweredOff,
    SavingState,
    RestoringState,
    Aborted,
    Inaccessible,
    Unknown,
}

// Define the SSH configuration struct
pub struct SshConfig {
    pub host: String,
    pub port: u16,
    pub username: String,
    pub password: Option<String>,
    pub private_key_path: Option<PathBuf>,
}

// Define the filesystem information struct
pub struct FilesystemInfo {
    pub total_space: u64,
    pub used_space: u64,
    pub available_space: u64,
}

// Export the concrete local VirtualBox implementation module
pub mod virtualbox;
```
