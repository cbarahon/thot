```rust
use std::fs;
use std::path::Path;
use std::process::Command;
use chrono::Local;

fn capture_screenshot(vm_name: &str, output_dir: &Path) -> Result<String, String> {
    let timestamp = Local::now().format("%Y%m%d%H%M%S").to_string();
    let output_path = output_dir.join(format!("screenshot_{}.png", timestamp));

    let result = Command::new("VBoxManage")
        .args(&["controlvm", vm_name, "screenshotpng", output_path.to_str().unwrap()])
        .output()
        .map_err(|e| format!("Failed to execute VBoxManage command: {}", e))?;

    if result.status.success() {
        let output_path_str = output_path.to_str().unwrap();
        Ok(format!("Screenshot captured successfully: {}", output_path_str))
    } else {
        let stderr = String::from_utf8_lossy(&result.stderr);
        Err(format!("Failed to capture screenshot: {}", stderr))
    }
}

fn main() {
    let vm_name = "your_vm_name"; // Replace with the actual VM name
    let output_dir = Path::new("/home/carlos/worktrees/thot/crates/thot-runner/src/vbox/output"); // Replace with the actual output directory

    match capture_screenshot(vm_name, output_dir) {
        Ok(result) => println!("{}", result),
        Err(e) => eprintln!("{}", e),
    }
}
```
