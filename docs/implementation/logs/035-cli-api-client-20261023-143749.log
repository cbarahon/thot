```rust
use reqwest::{Client, Error, Response};
use serde::{Deserialize, Serialize};
use std::time::Duration;

#[derive(Serialize, Deserialize)]
struct VersionResponse {
    version: String,
}

#[derive(Serialize, Deserialize)]
struct StatusResponse {
    status: String,
}

#[derive(Serialize, Deserialize)]
struct CancelResponse {
    message: String,
}

#[derive(Serialize, Deserialize)]
struct CleanupResponse {
    message: String,
}

pub struct APIClient {
    client: Client,
    base_url: String,
}

impl APIClient {
    pub fn new(host: &str, port: u16) -> Self {
        let base_url = format!("http://{}:{}", host, port);
        APIClient {
            client: Client::builder()
                .timeout(Duration::from_secs(10))
                .build()
                .unwrap(),
            base_url,
        }
    }

    async fn request<T: Deserialize<'de>>(&self, method: &str, path: &str) -> Result<T, Error> {
        let url = format!("{}/{}", self.base_url, path);
        let response = self.client.request(method.parse()?, url).send().await?;
        if response.status().is_success() {
            response.json().await
        } else {
            let error_body = response.text().await?;
            Err(Error::msg(format!("HTTP error: {} - {}", response.status(), error_body)))
        }
    }

    pub async fn get_version(&self) -> Result<VersionResponse, Error> {
        self.request("GET", "run/expedient/version").await
    }

    pub async fn get_status(&self) -> Result<StatusResponse, Error> {
        self.request("GET", "run/expedient/status").await
    }

    pub async fn cancel(&self) -> Result<CancelResponse, Error> {
        self.request("POST", "run/expedient/cancel").await
    }

    pub async fn cleanup(&self) -> Result<CleanupResponse, Error> {
        self.request("POST", "run/expedient/cleanup").await
    }
}
```
