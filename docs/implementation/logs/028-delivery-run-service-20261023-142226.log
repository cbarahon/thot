```rust
use std::collections::HashMap;
use std::sync::{Arc, Mutex};
use tokio::sync::mpsc;

#[derive(Debug)]
enum DeliveryRunError {
    PreflightFailed,
    CancellationRequested,
    RetryLimitExceeded,
}

#[derive(Debug)]
enum DeliveryStatus {
    Pending,
    Running,
    Completed,
    Canceled,
}

#[derive(Debug)]
struct Delivery {
    id: String,
    // Add other fields as needed
}

#[derive(Debug)]
struct DeliveryRun {
    id: String,
    project_id: String,
    delivery_collection: Vec<Delivery>,
    host: String,
    status: DeliveryStatus,
    expedients: HashMap<String, String>,
    cancellation_requested: bool,
    retry_limit: u32,
    retry_count: u32,
}

impl DeliveryRun {
    fn new(project_id: String, delivery_collection: Vec<Delivery>, host: String) -> Self {
        DeliveryRun {
            id: uuid::Uuid::new_v4().to_string(),
            project_id,
            delivery_collection,
            host,
            status: DeliveryStatus::Pending,
            expedients: HashMap::new(),
            cancellation_requested: false,
            retry_limit: 3,
            retry_count: 0,
        }
    }

    async fn run(&mut self) -> Result<(), DeliveryRunError> {
        if self.cancellation_requested {
            return Err(DeliveryRunError::CancellationRequested);
        }

        for delivery in &self.delivery_collection {
            if self.cancellation_requested {
                return Err(DeliveryRunError::CancellationRequested);
            }

            if self.retry_count >= self.retry_limit {
                return Err(DeliveryRunError::RetryLimitExceeded);
            }

            if let Err(_) = self.preflight() {
                return Err(DeliveryRunError::PreflightFailed);
            }

            // Simulate delivery processing
            tokio::time::sleep(tokio::time::Duration::from_secs(1)).await;

            // Update status and expedients
            self.status = DeliveryStatus::Completed;
            self.expedients.insert(delivery.id.clone(), "Processed".to_string());
        }

        Ok(())
    }

    fn preflight(&self) -> Result<(), DeliveryRunError> {
        // Simulate preflight check
        if self.host.is_empty() {
            return Err(DeliveryRunError::PreflightFailed);
        }

        Ok(())
    }

    fn cancel(&mut self) {
        self.cancellation_requested = true;
        self.status = DeliveryStatus::Canceled;
    }
}

#[derive(Debug)]
struct DeliveryRunService {
    runs: Arc<Mutex<HashMap<String, DeliveryRun>>>,
    sender: mpsc::Sender<DeliveryRun>,
}

impl DeliveryRunService {
    fn new() -> Self {
        let (sender, receiver) = mpsc::channel(32);
        tokio::spawn(async move {
            while let Some(mut run) = receiver.recv().await {
                if let Err(_) = run.run().await {
                    // Handle error
                }
            }
        });

        DeliveryRunService {
            runs: Arc::new(Mutex::new(HashMap::new())),
            sender,
        }
    }

    async fn create_run(
        &self,
        project_id: String,
        delivery_collection: Vec<Delivery>,
        host: String,
    ) -> Result<(), DeliveryRunError> {
        let mut runs = self.runs.lock().unwrap();
        let run = DeliveryRun::new(project_id, delivery_collection, host);
        runs.insert(run.id.clone(), run);
        self.sender.send(runs.get(&run.id).unwrap().clone()).await?;
        Ok(())
    }

    async fn cancel_run(&self, run_id: &str) {
        let mut runs = self.runs.lock().unwrap();
        if let Some(run) = runs.get_mut(run_id) {
            run.cancel();
        }
    }

    async fn get_run_status(&self, run_id: &str) -> Option<DeliveryStatus> {
        let runs = self.runs.lock().unwrap();
        runs.get(run_id).map(|run| run.status)
    }
}
