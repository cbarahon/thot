```rust
use std::{env, net::SocketAddr};
use thot_engine::{SqliteStudentRepository, StudentService};
use thot_delivery::{load_vm_activity_config, connect_delivery_repository, ArtifactService, IntakeService, ProjectService, PreflightService, RunnerService, ExecutorService, RunService};
use tracing_subscriber::EnvFilter;

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    tracing_subscriber::fmt()
        .with_env_filter(
            EnvFilter::try_from_default_env().unwrap_or_else(|_| EnvFilter::new("info")),
        )
        .init();

    let host = env::var("THOTD_HOST").unwrap_or_else(|_| "127.0.0.1".into());
    let port: u16 = env::var("THOTD_PORT")
        .unwrap_or_else(|_| "8765".into())
        .parse()?;
    let database =
        env::var("THOTD_DATABASE").unwrap_or_else(|_| "sqlite:./data/thot.sqlite3".into());

    let repository = SqliteStudentRepository::connect(&database).await?;
    let student_service = StudentService::new(repository);

    let vm_activity_config = load_vm_activity_config().await?;
    let delivery_repository = connect_delivery_repository(&vm_activity_config).await?;
    let artifact_service = ArtifactService::new(delivery_repository.clone());
    let intake_service = IntakeService::new(delivery_repository.clone());
    let project_service = ProjectService::new(delivery_repository.clone());
    let preflight_service = PreflightService::new(delivery_repository.clone());
    let runner_service = RunnerService::new(delivery_repository.clone());
    let executor_service = ExecutorService::new(delivery_repository.clone());
    let run_service = RunService::new(delivery_repository.clone());

    let app = thot_api::router(student_service, artifact_service, intake_service, project_service, preflight_service, runner_service, executor_service, run_service);

    let address: SocketAddr = format!("{host}:{port}").parse()?;
    let listener = tokio::net::TcpListener::bind(address).await?;

    tracing::info!(%address, %database, "thotd iniciado");
    axum_serve(listener, app).await?;
    Ok(())
}

async fn axum_serve(
    listener: tokio::net::TcpListener,
    app: axum::Router,
) -> Result<(), std::io::Error> {
    axum::serve(listener, app).await
}
```
