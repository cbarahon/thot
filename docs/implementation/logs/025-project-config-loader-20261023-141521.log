```rust
use serde::{Deserialize, Serialize};
use std::fs;
use std::path::Path;
use sha2::{Sha256, Digest};

#[derive(Serialize, Deserialize, Debug)]
struct ProjectConfig {
    project_id: String,
    schema_version: String,
    vm_test_policy: String,
    limits: Limits,
    ssh_secret_ref: String,
}

#[derive(Serialize, Deserialize, Debug)]
struct Limits {
    cpu: u32,
    memory: u32,
}

fn load_and_validate_project_config(project_id: &str, project_root: &str) -> Result<ProjectConfig, String> {
    let config_path = Path::new(project_root).join(format!("{}.yaml", project_id));
    if !config_path.exists() {
        return Err("Project config file does not exist".to_string());
    }

    let config_content = fs::read_to_string(&config_path).map_err(|e| format!("Failed to read config file: {}", e))?;
    let config: ProjectConfig = serde_yaml::from_str(&config_content).map_err(|e| format!("Failed to parse config file: {}", e))?;

    if config.schema_version != "1.0" {
        return Err("Unsupported schema version".to_string());
    }

    if config.vm_test_policy != "fixed" {
        return Err("Invalid VM test policy".to_string());
    }

    if config.limits.cpu == 0 || config.limits.memory == 0 {
        return Err("Invalid limits".to_string());
    }

    if config.ssh_secret_ref.is_empty() {
        return Err("SSH secret reference is required".to_string());
    }

    let config_hash = Sha256::new()
        .chain(config_content.as_bytes())
        .result()
        .iter()
        .map(|byte| format!("{:02x}", byte))
        .collect::<String>();

    // Persist the config and its hash through the artifact store
    // This part is not implemented here as it depends on the specific artifact store

    Ok(config)
}
```
