```rust
use std::process::Command;
use std::time::Instant;
use std::fs;
use std::path::Path;

fn import_ova(ova_path: &str, storage_dir: &str) -> Result<String, String> {
    let start_time = Instant::now();
    let vm_name = Path::new(ova_path).file_stem().unwrap().to_str().unwrap();
    let vm_uuid = format!("{}-{}", vm_name, start_time.elapsed().as_secs());

    let args = vec![
        "import",
        ova_path,
        "--name",
        vm_name,
        "--ostype",
        "Linux_64",
        "--memory",
        "2048",
        "--cpus",
        "2",
        "--vram",
        "128",
        "--storagectl",
        "SATA",
        "--port",
        "0",
        "--device",
        "0",
        "--type",
        "hdd",
        "--medium",
        &format!("{}/{}.vdi", storage_dir, vm_uuid),
    ];

    let output = Command::new("VBoxManage")
        .args(&args)
        .output()
        .map_err(|e| format!("Failed to execute VBoxManage: {}", e))?;

    if !output.status.success() {
        return Err(format!("VBoxManage import failed: {}", String::from_utf8_lossy(&output.stderr)));
    }

    let duration = start_time.elapsed();
    let diagnostics = format!("Imported VM: {}, Duration: {:?}", vm_uuid, duration);

    let register_args = vec![
        "registervm",
        &format!("{}/{}.vdi", storage_dir, vm_uuid),
    ];

    let register_output = Command::new("VBoxManage")
        .args(&register_args)
        .output()
        .map_err(|e| format!("Failed to execute VBoxManage: {}", e))?;

    if !register_output.status.success() {
        return Err(format!("VBoxManage register failed: {}", String::from_utf8_lossy(&register_output.stderr)));
    }

    Ok(diagnostics)
}

fn main() {
    let ova_path = "/path/to/your/ova/file.ova";
    let storage_dir = "/path/to/your/storage/directory";

    match import_ova(ova_path, storage_dir) {
        Ok(diagnostics) => println!("{}", diagnostics),
        Err(e) => eprintln!("Error: {}", e),
    }
}
```
