```rust
use std::net::TcpStream;
use std::time::{Instant, Duration};
use std::io::{Read, Write};
use std::fs::File;
use std::io::Error as IoError;
use std::io::ErrorKind;
use std::path::Path;
use std::io::SeekFrom;

const HTTP_PROBE_URL: &str = "http://127.0.0.1:8080/";
const TIMEOUT: Duration = Duration::from_secs(10);
const MAX_BODY_SIZE: u64 = 10 * 1024 * 1024; // 10 MiB

#[derive(Debug)]
struct HttpProbeResult {
    attempts: u32,
    status: u16,
    timing: Duration,
    body_artifact: String,
    transport_errors: Vec<String>,
}

fn http_probe() -> HttpProbeResult {
    let mut attempts = 0;
    let mut transport_errors = Vec::new();
    let start_time = Instant::now();

    loop {
        attempts += 1;
        match TcpStream::connect(HTTP_PROBE_URL) {
            Ok(mut stream) => {
                stream.set_read_timeout(Some(TIMEOUT)).unwrap();
                stream.set_write_timeout(Some(TIMEOUT)).unwrap();

                let request = format!("GET {} HTTP/1.1\r\nHost: {}\r\nConnection: close\r\n\r\n", HTTP_PROBE_URL, HTTP_PROBE_URL);
                stream.write_all(request.as_bytes()).unwrap();

                let mut response = String::new();
                stream.read_to_string(&mut response).unwrap();

                if let Some(status_line) = response.lines().next() {
                    if let Some(status_code) = status_line.split_whitespace().nth(1) {
                        if let Ok(status) = status_code.parse::<u16>() {
                            let elapsed_time = start_time.elapsed();
                            let body_artifact = save_body(&response, MAX_BODY_SIZE).unwrap();
                            return HttpProbeResult {
                                attempts,
                                status,
                                timing: elapsed_time,
                                body_artifact,
                                transport_errors,
                            };
                        }
                    }
                }
                transport_errors.push("Invalid HTTP response".to_string());
            },
            Err(e) => {
                transport_errors.push(format!("TCP connection error: {}", e));
            }
        }

        if start_time.elapsed() >= TIMEOUT {
            transport_errors.push("Startup deadline expired".to_string());
            break;
        }
    }

    HttpProbeResult {
        attempts,
        status: 0,
        timing: start_time.elapsed(),
        body_artifact: "".to_string(),
        transport_errors,
    }
}

fn save_body(body: &str, max_size: u64) -> Result<String, IoError> {
    let mut body_bytes = body.as_bytes();
    let mut body_size = body_bytes.len() as u64;

    if body_size > max_size {
        body_bytes = &body_bytes[..max_size as usize];
        body_size = max_size;
    }

    let mut file_path = Path::new("body_artifact.txt");
    let mut file = File::create(&file_path)?;
    file.write_all(body_bytes)?;
    file.set_len(body_size)?;

    Ok(file_path.to_str().unwrap().to_string())
}
```
