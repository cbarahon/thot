```rust
use std::process::{Command, Stdio};
use std::time::{Duration, Instant};
use std::thread;

fn vbox_manage(command: &str, args: &[&str]) -> Result<String, String> {
    let output = Command::new("VBoxManage")
        .args(args)
        .output()
        .map_err(|e| format!("Failed to execute VBoxManage: {}", e))?;
    if output.status.success() {
        Ok(String::from_utf8_lossy(&output.stdout).into_owned())
    } else {
        Err(String::from_utf8_lossy(&output.stderr).into_owned())
    }
}

fn check_vm_state(vm_uuid: &str) -> Result<String, String> {
    vbox_manage("showvminfo", &[vm_uuid, "--machinereadable"])
}

fn start_vm_headless(vm_uuid: &str) -> Result<String, String> {
    vbox_manage("startvm", &[vm_uuid, "--type", "headless"])
}

fn request_graceful_shutdown(vm_uuid: &str) -> Result<String, String> {
    vbox_manage("controlvm", &[vm_uuid, "acpipowerbutton"])
}

fn wait_for_power_off(vm_uuid: &str, grace_period: Duration) -> Result<String, String> {
    let start = Instant::now();
    while start.elapsed() < grace_period {
        if check_vm_state(vm_uuid)?.contains("poweroff") {
            return Ok("VM powered off gracefully".to_string());
        }
        thread::sleep(Duration::from_secs(1));
    }
    Ok("Grace period expired, forcing power off".to_string())
}

fn force_power_off(vm_uuid: &str) -> Result<String, String> {
    vbox_manage("controlvm", &[vm_uuid, "poweroff"])
}

fn main() -> Result<(), String> {
    let vm_uuid = "your_vm_uuid_here"; // Replace with actual VM UUID
    let grace_period = Duration::from_secs(30);

    let start_time = Instant::now();
    let start_result = start_vm_headless(vm_uuid);
    let start_duration = start_time.elapsed();

    let check_time = Instant::now();
    let check_result = check_vm_state(vm_uuid);
    let check_duration = check_time.elapsed();

    let shutdown_time = Instant::now();
    let shutdown_result = request_graceful_shutdown(vm_uuid);
    let shutdown_duration = shutdown_time.elapsed();

    let power_off_time = Instant::now();
    let power_off_result = wait_for_power_off(vm_uuid, grace_period);
    let power_off_duration = power_off_time.elapsed();

    let force_shutdown_time = Instant::now();
    let force_shutdown_result = force_power_off(vm_uuid);
    let force_shutdown_duration = force_shutdown_time.elapsed();

    println!("Start VM Headless: {:?}", start_result);
    println!("Start Duration: {:?}", start_duration);
    println!("Check VM State: {:?}", check_result);
    println!("Check Duration: {:?}", check_duration);
    println!("Request Graceful Shutdown: {:?}", shutdown_result);
    println!("Shutdown Duration: {:?}", shutdown_duration);
    println!("Wait for Power Off: {:?}", power_off_result);
    println!("Power Off Duration: {:?}", power_off_duration);
    println!("Force Power Off: {:?}", force_shutdown_result);
    println!("Force Shutdown Duration: {:?}", force_shutdown_duration);

    Ok(())
}
```
