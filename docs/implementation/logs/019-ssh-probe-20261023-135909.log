```rust
use std::process::{Command, Stdio};
use std::time::Duration;
use ssh2::{Session, Connect};
use std::fs::File;
use std::io::{self, Write};
use std::path::Path;

fn main() -> io::Result<()> {
    let host = "127.0.0.1";
    let port = 2222;
    let username = "carlos";
    let password = "host-provided-secret"; // Never place the password in process arguments, logs, reports, or project YAML.
    let known_hosts_path = "/tmp/ssh_probe_known_hosts";

    // Create a fresh known-hosts file scoped to this VM endpoint
    let mut known_hosts_file = File::create(known_hosts_path)?;
    known_hosts_file.write_all(b"")?;

    // Connect to the SSH server
    let tcp_stream = std::net::TcpStream::connect(format!("{}:{}", host, port))?;
    let mut session = Session::new()?;
    session.set_tcp_stream(tcp_stream);
    session.set_known_hosts_path(known_hosts_path);
    session.set_auth_password(username, password)?;
    session.connect()?;

    // Accept and record its first key only for this loopback connection, and reject a changed key
    if !session.accept_host_key()? {
        return Err(io::Error::new(io::ErrorKind::Other, "Host key changed"));
    }

    // Enforce 15-second connect/command timeouts
    session.set_timeout(Duration::from_secs(15))?;

    // Run exactly LC_ALL=C df -B1
    let output = Command::new("sh")
        .arg("-c")
        .arg("LC_ALL=C df -B1")
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .spawn()?
        .wait_with_output()?;

    // Retain bounded stdout/stderr
    let stdout = String::from_utf8_lossy(&output.stdout);
    let stderr = String::from_utf8_lossy(&output.stderr);

    // Parse all filesystem rows where possible
    let filesystem_rows = stdout.lines().skip(1); // Skip the header row

    // Report parse/auth/connection errors explicitly
    if !output.status.success() {
        return Err(io::Error::new(io::ErrorKind::Other, format!("Command failed: {}", stderr)));
    }

    for row in filesystem_rows {
        if let Some(fields) = row.split_whitespace().collect::<Vec<&str>>().as_slice() {
            if fields.len() >= 4 {
                let filesystem = fields[0];
                let size = fields[1];
                let used = fields[2];
                let available = fields[3];
                println!("Filesystem: {}, Size: {}, Used: {}, Available: {}", filesystem, size, used, available);
            } else {
                eprintln!("Invalid filesystem row: {}", row);
            }
        } else {
            eprintln!("Invalid filesystem row: {}", row);
        }
    }

    Ok(())
}
```
