```rust
use std::fs::{self, File};
use std::io::{self, Write};
use std::path::{Path, PathBuf};
use std::sync::{Arc, Mutex};

#[derive(Clone)]
struct ArtifactStore {
    root_dir: PathBuf,
    project_dir: PathBuf,
    run_dir: PathBuf,
    delivery_dir: PathBuf,
}

impl ArtifactStore {
    fn new(root_dir: PathBuf, project_id: &str, run_id: &str, delivery_id: &str) -> io::Result<Self> {
        let project_dir = root_dir.join(project_id);
        let run_dir = project_dir.join(run_id);
        let delivery_dir = run_dir.join(delivery_id);

        fs::create_dir_all(&delivery_dir)?;

        Ok(ArtifactStore {
            root_dir,
            project_dir,
            run_dir,
            delivery_dir,
        })
    }

    fn store_artifact(&self, artifact_name: &str, content: &[u8]) -> io::Result<PathBuf> {
        let artifact_path = self.delivery_dir.join(artifact_name);
        let temp_path = artifact_path.with_extension("tmp");

        let mut temp_file = File::create(&temp_path)?;
        temp_file.write_all(content)?;

        fs::rename(&temp_path, &artifact_path)?;

        Ok(artifact_path)
    }

    fn store_project_snapshot(&self, snapshot: &[u8]) -> io::Result<PathBuf> {
        let snapshot_path = self.project_dir.join("snapshot.ova");
        let temp_path = snapshot_path.with_extension("tmp");

        let mut temp_file = File::create(&temp_path)?;
        temp_file.write_all(snapshot)?;

        fs::rename(&temp_path, &snapshot_path)?;

        Ok(snapshot_path)
    }

    fn store_log(&self, log_name: &str, content: &[u8]) -> io::Result<PathBuf> {
        let log_path = self.delivery_dir.join(log_name);
        let temp_path = log_path.with_extension("tmp");

        let mut temp_file = File::create(&temp_path)?;
        temp_file.write_all(content)?;

        fs::rename(&temp_path, &log_path)?;

        Ok(log_path)
    }

    fn get_artifact_path(&self, artifact_name: &str) -> PathBuf {
        self.delivery_dir.join(artifact_name)
    }

    fn get_project_snapshot_path(&self) -> PathBuf {
        self.project_dir.join("snapshot.ova")
    }

    fn get_log_path(&self, log_name: &str) -> PathBuf {
        self.delivery_dir.join(log_name)
    }
}

fn main() -> io::Result<()> {
    let root_dir = PathBuf::from("/path/to/artifact/store");
    let project_id = "project123";
    let run_id = "run456";
    let delivery_id = "delivery789";

    let artifact_store = ArtifactStore::new(root_dir, project_id, run_id, delivery_id)?;

    let artifact_content = b"Example artifact content";
    let artifact_path = artifact_store.store_artifact("example.txt", artifact_content)?;
    println!("Artifact stored at: {:?}", artifact_path);

    let snapshot_content = b"Example project snapshot";
    let snapshot_path = artifact_store.store_project_snapshot(snapshot_content)?;
    println!("Project snapshot stored at: {:?}", snapshot_path);

    let log_content = b"Example log content";
    let log_path = artifact_store.store_log("example.log", log_content)?;
    println!("Log stored at: {:?}", log_path);

    Ok(())
}
```
