use std::path::PathBuf;
use std::time::Duration;
use tokio::process::Command;

mod import;
mod inspection;
mod lifecycle;
mod screenshot;
mod cleanup;

pub struct LocalVirtualBoxRunner {
    vbox_manage_path: PathBuf,
    vbox_user_home: PathBuf,
    timeout: Duration,
    storage_root: PathBuf,
    output_limits: OutputLimits,
}

impl LocalVirtualBoxRunner {
    pub fn new(
        vbox_manage_path: PathBuf,
        vbox_user_home: PathBuf,
        timeout: Duration,
        storage_root: PathBuf,
        output_limits: OutputLimits,
    ) -> Self {
        LocalVirtualBoxRunner {
            vbox_manage_path,
            vbox_user_home,
            timeout,
            storage_root,
            output_limits,
        }
    }
}

pub struct OutputLimits {
    // Define output limits here
}

#[async_trait::async_trait]
pub trait AsyncExecutionBackend {
    async fn run(&self, command: &str) -> Result<(), Box<dyn std::error::Error>>;
}

#[async_trait::async_trait]
impl AsyncExecutionBackend for LocalVirtualBoxRunner {
    async fn run(&self, command: &str) -> Result<(), Box<dyn std::error::Error>> {
        let mut cmd = Command::new(&self.vbox_manage_path);
        cmd.args(command.split_whitespace());
        cmd.env("VBOX_USER_HOME", &self.vbox_user_home);
        cmd.timeout(self.timeout);

        let output = cmd.output().await?;
        if output.status.success() {
            Ok(())
        } else {
            Err(format!("Command failed: {:?}", output.stderr).into())
        }
    }
}
