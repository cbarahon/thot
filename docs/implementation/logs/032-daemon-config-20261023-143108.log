```rust
use std::env;
use std::path::PathBuf;
use std::time::Duration;

#[derive(Debug, Clone)]
pub struct VmActivityConfig {
    pub bind_host: String,
    pub bind_port: u16,
    pub database_url: String,
    pub project_root: PathBuf,
    pub delivery_root: PathBuf,
    pub artifact_root: PathBuf,
    pub vbox_manage_path: PathBuf,
    pub vbox_user_home: PathBuf,
    pub storage_root: PathBuf,
    pub size_limit: u64,
    pub free_space_limit: u64,
    pub output_limit: u64,
    pub timeouts: Timeouts,
    pub ssh_secret_source: String,
    pub firewall_confirmation: bool,
}

#[derive(Debug, Clone)]
pub struct Timeouts {
    pub connect: Duration,
    pub read: Duration,
    pub write: Duration,
}

impl VmActivityConfig {
    pub fn from_env() -> Result<Self, String> {
        let bind_host = env::var("THOTD_BIND_HOST").unwrap_or_else(|_| "127.0.0.1".to_string());
        let bind_port = env::var("THOTD_BIND_PORT")
            .map(|v| v.parse().map_err(|_| "Invalid THOTD_BIND_PORT".to_string()))
            .unwrap_or(8081);
        let database_url = env::var("THOTD_DATABASE_URL").unwrap_or_else(|_| "sqlite:///thotd.db".to_string());
        let project_root = env::var("THOTD_PROJECT_ROOT")
            .map(|v| PathBuf::from(v))
            .unwrap_or_else(|_| PathBuf::from("/home/carlos/projects"));
        let delivery_root = env::var("THOTD_DELIVERY_ROOT")
            .map(|v| PathBuf::from(v))
            .unwrap_or_else(|_| PathBuf::from("/home/carlos/deliveries"));
        let artifact_root = env::var("THOTD_ARTIFACT_ROOT")
            .map(|v| PathBuf::from(v))
            .unwrap_or_else(|_| PathBuf::from("/home/carlos/artifacts"));
        let vbox_manage_path = env::var("THOTD_VBOX_MANAGE_PATH")
            .map(|v| PathBuf::from(v))
            .unwrap_or_else(|_| PathBuf::from("/usr/bin/VBoxManage"));
        let vbox_user_home = env::var("THOTD_VBOX_USER_HOME")
            .map(|v| PathBuf::from(v))
            .unwrap_or_else(|_| PathBuf::from("/home/carlos/.VirtualBox"));
        let storage_root = env::var("THOTD_STORAGE_ROOT")
            .map(|v| PathBuf::from(v))
            .unwrap_or_else(|_| PathBuf::from("/home/carlos/storage"));
        let size_limit = env::var("THOTD_SIZE_LIMIT")
            .map(|v| v.parse().map_err(|_| "Invalid THOTD_SIZE_LIMIT".to_string()))
            .unwrap_or(1073741824); // 1GB
        let free_space_limit = env::var("THOTD_FREE_SPACE_LIMIT")
            .map(|v| v.parse().map_err(|_| "Invalid THOTD_FREE_SPACE_LIMIT".to_string()))
            .unwrap_or(536870912); // 512MB
        let output_limit = env::var("THOTD_OUTPUT_LIMIT")
            .map(|v| v.parse().map_err(|_| "Invalid THOTD_OUTPUT_LIMIT".to_string()))
            .unwrap_or(10485760); // 10MB
        let timeouts = Timeouts {
            connect: env::var("THOTD_TIMEOUT_CONNECT")
                .map(|v| v.parse().map_err(|_| "Invalid THOTD_TIMEOUT_CONNECT".to_string()))
                .unwrap_or(Duration::from_secs(5)),
            read: env::var("THOTD_TIMEOUT_READ")
                .map(|v| v.parse().map_err(|_| "Invalid THOTD_TIMEOUT_READ".to_string()))
                .unwrap_or(Duration::from_secs(10)),
            write: env::var("THOTD_TIMEOUT_WRITE")
                .map(|v| v.parse().map_err(|_| "Invalid THOTD_TIMEOUT_WRITE".to_string()))
                .unwrap_or(Duration::from_secs(10)),
        };
        let ssh_secret_source = env::var("THOTD_SSH_SECRET_SOURCE").unwrap_or_else(|_| "/home/carlos/.ssh/id_rsa".to_string());
        let firewall_confirmation = env::var("THOTD_FIREWALL_CONFIRMATION")
            .map(|v| v.parse().map_err(|_| "Invalid THOTD_FIREWALL_CONFIRMATION".to_string()))
            .unwrap_or(false);

        Ok(VmActivityConfig {
            bind_host,
            bind_port,
            database_url,
            project_root,
            delivery_root,
            artifact_root,
            vbox_manage_path,
            vbox_user_home,
            storage_root,
            size_limit,
            free_space_limit,
            output_limit,
            timeouts,
            ssh_secret_source,
            firewall_confirmation,
        })
    }
}
